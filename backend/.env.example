# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=ARIA
APP_VERSION=1.0.0
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aria:aria@localhost:5432/aria

# ── Vector DB ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aria_memories

# ── AI Providers ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Apple Sign-In ──────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=com.your.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── Microsoft OAuth ────────────────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ── Firebase (FCM Push Notifications) ─────────────────────────────────────────
# Paste the full JSON of your Firebase service account key as a single-line string
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=168

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated origins or * for all
ALLOWED_ORIGINS=["http://localhost:3000","https://yourapp.com"]

# ── Encryption ─────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
